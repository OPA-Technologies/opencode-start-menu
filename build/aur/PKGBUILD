# shellcheck disable=SC2034,SC2154,SC2164
# Mainteneur : Opa <opa@localhost>
# Source publique : release v$pkgver du repo GitHub (tarball src, sha256 suivi ci-dessous).
pkgname=opencode-start-menu
pkgver=1.0.0
pkgrel=1
pkgdesc="Launcher TUI des projets opencode"
url="https://opencode.ai"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
depends=('opencode' 'sudo')
makedepends=('cargo' 'rust')
source=("opencode-start-menu-$pkgver.tar.gz::https://github.com/OPA-Technologies/opencode-start-menu/releases/download/v$pkgver/op-$pkgver-src.tar.gz")
sha256sums=('eeead512e53cbae7130e1d69f7666103f28b15ae253794cb3c9d0834a122e036')

build()
  {
    cd "$srcdir"
    cargo build --release --locked
  }

package()
  {
    cd "$srcdir"
    install -Dm755 target/release/opencode-start-menu "$pkgdir"/usr/bin/op
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
  }